{
  "failOnWarnings": false,
  "structure": {
    "componentExtensions": [".tsx", ".jsx"],
    "allowedPaths": [
      "src/components/ui/",
      "src/components/layout/",
      "src/components/modals/",
      "src/components/toast/",
      "src/components/rbac/",
      "src/app/(client)/[org]/_components/",
      "src/app/(homepage)/_components/",
      "src/app/(client)/[org]/settings/",
      "src/app/(auth)/",
      "src/app/(accept_general_invitation)/",
      "src/app/(accept_org_invitation)/",
      "src/app/(client)/billing/",
      "src/emails/"
    ],
    "allowedExactFiles": [
      "src/app/layout.tsx",
      "src/app/client-layout.tsx",
      "src/app/(client)/[org]/layout.tsx",
      "src/app/(client)/[org]/client-layout.tsx",
      "src/app/(homepage)/layout.tsx",
      "src/app/(client)/[org]/home/channels/[id]/settings/page.tsx",
      "src/app/(client)/[org]/home/channels/[id]/settings/history/page.tsx"
    ]
  },
  "reuse": {
    "sharedComponents": [
      { "name": "button.tsx", "path": "src/components/ui/button.tsx" },
      { "name": "dialog.tsx", "path": "src/components/ui/dialog.tsx" },
      {
        "name": "alert-dialog.tsx",
        "path": "src/components/ui/alert-dialog.tsx"
      },
      {
        "name": "invite-modal.tsx",
        "path": "src/app/(client)/[org]/_components/user-management/invite-modal.tsx"
      }
    ],
    "duplicatePatterns": [
      "buzzInviteModal",
      "CallParticipantList",
      "CallParticipant",
      "HuddleEmojiReactions",
      "buzz-menu",
      "screen-share-player",
      "general-timeout",
      "buzz-timeout"
    ]
  },
  "imports": {
    "preferredAlias": "~/",
    "deprecatedAlias": "@/"
  },
  "hardcodedUrls": {
    "allowPatterns": ["^https?://(www\\.)?w3\\.org(/|$)"],
    "excludePathPrefixes": ["cypress/", ".github/"],
    "scanExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs"]
  },
  "secrets": {
    "forbiddenFilePatterns": [
      "^\\.env",
      "^\\.ENV",
      "\\.pem$",
      "credentials\\.json$",
      "secrets\\.json$",
      "service-account.*\\.json$"
    ],
    "addedLinePatterns": [
      { "name": "stripe-live-key", "pattern": "sk_live_[A-Za-z0-9]{16,}" },
      { "name": "stripe-test-key", "pattern": "sk_test_[A-Za-z0-9]{16,}" },
      { "name": "github-pat", "pattern": "ghp_[A-Za-z0-9]{20,}" },
      { "name": "google-api-key", "pattern": "AIza[A-Za-z0-9_-]{20,}" },
      { "name": "aws-access-key", "pattern": "AKIA[A-Z0-9]{16}" },
      { "name": "slack-token", "pattern": "xox[baprs]-[A-Za-z0-9-]{10,}" },
      { "name": "jwt-bearer", "pattern": "Bearer eyJ[A-Za-z0-9_-]{10,}\\." },
      {
        "name": "private-key-block",
        "pattern": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----"
      },
      {
        "name": "agora-certificate",
        "pattern": "AGORA_APP_CERTIFICATE\\s*=\\s*[\"'][^\"']+[\"']"
      }
    ],
    "genericAssignments": {
      "minLength": 20,
      "minEntropy": 3.5
    },
    "scanExtensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".json",
      ".yaml",
      ".yml"
    ],
    "excludeFromLineScan": ["pnpm-lock.yaml", "package-lock.json", "yarn.lock"]
  },
  "jscpd": {
    "minLines": 10,
    "minTokens": 50
  }
}
