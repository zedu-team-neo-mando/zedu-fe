{
  "version": 1,
  "fork": {
    "owner": "zedu-hng",
    "repo": "zedu-fe"
  },
  "upstream": {
    "owner": "zeduchat",
    "repo": "zedu-fe"
  },
  "branches": {
    "work": "dev",
    "staging": "central-staging",
    "release": "release-candidate",
    "upstreamWork": "main",
    "upstreamTarget": "staging"
  },
  "bot": {
    "name": "zedu-release-bot",
    "email": "release-bot@zedu-hng.local"
  },
  "releaseLabel": "release",
  "releaseMention": "@Ayodejioladimeji",
  "maxAttempts": 3,
  "tagReleases": true,
  "protected": [
    ".github/",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "HNG15-INTERNSHIP.md",
    "PRD.md",
    "README.md",
    "env.example",
    "vercel.json"
  ],
  "replaceWithUpstream": [
    ".github",
    "CONTRIBUTING.md",
    "PRD.md",
    "README.md",
    "review-report.json",
    "review-report.md"
  ],
  "remove": ["AGENTS.md", "HNG15-INTERNSHIP.md", "env.example", "vercel.json"],
  "requiredOnStaging": [
    ".github/workflows/sync-release.yml",
    ".github/scripts/release/reconcile.mjs",
    ".github/release-manifest.json",
    "AGENTS.md"
  ],
  "mustBeAbsentInRelease": [
    "AGENTS.md",
    "HNG15-INTERNSHIP.md",
    "env.example",
    "vercel.json",
    ".github/release-manifest.json",
    ".github/scripts/release",
    ".github/workflows/sync-release.yml",
    ".github/preview",
    ".github/scripts/fe-preview.sh",
    ".github/workflows/fe-preview-deploy.yml",
    ".github/workflows/lead-approval.yml",
    ".github/workflows/pr-rules.yml",
    ".github/workflows/team-routing.yml"
  ]
}
